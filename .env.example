# ========== 链易配 配置模板 ==========
# 复制本文件为 .env，按需修改密码。.env 已被 .gitignore 排除，勿提交。

# ========== 数据库 ==========
# MySQL（必填）
# 格式: mysql+pymysql://用户名:密码@主机/数据库名
# Windows 注意: pymysql 连接无需特殊转义
# macOS (Homebrew MySQL): 默认安装后设置密码，或用 socket 认证
DATABASE_URL=mysql+pymysql://root:你的MySQL密码@localhost/lianyipei

# Neo4j（产业链图谱功能需要，非必须）
# 安装: brew install neo4j (macOS) 或 Neo4j Desktop (Windows)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=你的Neo4j密码

# Redis（可选，用于定时任务缓存）
REDIS_URL=redis://localhost:6379/0

# ========== Flask ==========
SECRET_KEY=change-this-to-random-string-in-production
APP_ENV=development
# Vite 开发端口与 Flask API 不同源时使用；生产请改为实际 HTTPS origin。
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FLASK_ENV=development
FLASK_DEBUG=1
# Production must run `flask db upgrade`; set this to 0 there so the web process
# never creates tables implicitly. It is intentionally commented for local demos.
# AUTO_CREATE_SCHEMA=0

# Mock 路由默认不注册；仅本地前端联调时显式开启，生产必须保持 false。
ENABLE_MOCK_API=false
MATERIAL_AV_MODE=basic
CLAMAV_COMMAND=clamscan
# Containerized production may point at a private clamd service instead of a
# local executable.  Do not expose this port publicly.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=30
MATERIAL_STORAGE_BACKEND=none
# MATERIAL_ENCRYPTION_KEY=generate-a-fernet-key
# MATERIAL_S3_BUCKET=lianyipei-private-materials
# MATERIAL_S3_REGION=cn-south-1
# MATERIAL_S3_ENDPOINT_URL=

# 本地联调：跳过登录验证（上线前务必关闭）
# DISABLE_API_AUTH=1
# DEV_API_LOGIN_ENTERPRISE_ID=1

# 生产部署：默认关闭联调免登录；如需定时任务只在独立进程执行，可设置 SCHEDULER_ENABLED=0
# SCHEDULER_ENABLED=1
# 若使用独立队列/Worker 进程，请在该进程环境设置；生产就绪检查会验证其中一项真实存在
# LIANYIPEI_WORKER_ENABLED=1
# 后台询价 worker 超过该时间未完成会自动重新入队（默认15分钟）
CHAIN_XIAOYI_QUEUE_LEASE_SECONDS=900
# 供应商报价默认有效窗口（小时），每条询价可在预览时覆盖
CHAIN_XIAOYI_RFQ_DEADLINE_HOURS=72
CHAIN_XIAOYI_AUTO_RFQ_SUPPLIER_LIMIT=5
CHAINXIAOYI_DATA_MAX_AGE_DAYS=180
# SCHEDULER_LOCK_FILE=/tmp/lianyipei-scheduler.lock

# ========== 大模型（Ollama 本地部署）==========
# 安装 Ollama:
#   macOS:  brew install ollama
#   Windows: https://ollama.com/download/windows
# 拉取模型:
#   ollama pull qwen2:7b    (7B 参数，约 4.4GB)
#   ollama pull qwen2.5:3b  (3B 参数，约 1.9GB，轻量备选)
# 验证: ollama list

# Ollama 服务地址（默认端口 11434）
# 远端 GPU 服务器示例: http://192.168.1.100:11434
OLLAMA_BASE_URL=http://localhost:11434

# 模型名须与 `ollama list` 中 name 列完全一致
# 推荐按需选择: qwen2:7b / qwen2.5:3b / qwen2.5:7b
OLLAMA_MODEL=qwen2:7b
BIZMIND_OLLAMA_MODEL=qwen2:7b

# 超时与 token 控制
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0

# ========== 链小易主 Agent（默认不调用外部模型）==========
# 开启前请先完成 Provider、隐私和费用审查；未配置时使用规则引擎。
CHAINXIAOYI_LOCAL_ENABLED=false
CHAINXIAOYI_LOCAL_BASE_URL=
CHAINXIAOYI_LOCAL_MODEL=
CHAINXIAOYI_CLOUD_ENABLED=false
# 生产默认强制使用 DeepSeek；仅在明确的应急窗口才设为 false（缺 key/模型故障会返回 503）。
# CHAINXIAOYI_CLOUD_REQUIRED=true
CHAINXIAOYI_ROUTING_MODE=local_first
CHAINXIAOYI_CLOUD_FILE_CONSENT_REQUIRED=true
# 生产必须使用显式 confirm=true 才能批准对外询价；开发演示可省略。
CHAINXIAOYI_REQUIRE_EXPLICIT_APPROVAL=false

# 前端仅用于明确开启演示订单，不配置时只展示真实订单。
# VITE_DEMO_MODE=false

# ========== 外部 API（可选，竞赛展演可不填）==========
# DeepSeek API（仅服务端注入，不要提交真实密钥）
# DEEPSEEK_API_KEY=replace-with-rotated-key
# DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Transient DeepSeek network/5xx failures are retried with bounded exponential backoff.
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BACKOFF_SECONDS=0.5
# CHAINXIAOYI_CLOUD_ENABLED=true

# 真实电子合同供应商；未配置时合同生成/签署会明确失败，不会返回模拟成功。
# ECONTRACT_PROVIDER=custom
# ECONTRACT_BASE_URL=https://your-approved-contract-provider.example/api
# ECONTRACT_API_KEY=
# ECONTRACT_API_SECRET=

# SMTP 询价/通知渠道；未配置时 Agent 只发送站内消息。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_NAME=链易配
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=true
# Provider delivery callbacks (HMAC-SHA256; do not reuse an SMTP/WeChat secret)
# RFQ_DELIVERY_CALLBACK_SECRET=generate-a-long-random-value
# RFQ_QUOTE_CALLBACK_SECRET=generate-a-different-long-random-value
# RFQ_EMAIL_INBOUND_SECRET=generate-a-third-long-random-value
# FULFILLMENT_CALLBACK_SECRET=generate-a-separate-order-lifecycle-value

# Optional real inbound supplier-email worker. It uses IMAP over SSL and only
# marks messages read after the signed callback returns 2xx.
# INBOUND_EMAIL_ENABLED=false
# INBOUND_IMAP_HOST=imap.example.com
# INBOUND_IMAP_PORT=993
# INBOUND_IMAP_USERNAME=rfq-inbox@example.com
# INBOUND_IMAP_PASSWORD=use-secret-manager
# INBOUND_IMAP_FOLDER=INBOX
# INBOUND_EMAIL_CALLBACK_URL=https://your-domain.example/api/chain-xiaoyi/email-quote-inbound
# INBOUND_EMAIL_BATCH_SIZE=20
# INBOUND_EMAIL_TIMEOUT_SECONDS=20

# AnythingLLM（可选知识库，竞赛展演可不填）
# ANYTHING_LLM_API_KEY=
# ANYTHING_LLM_WORKSPACE=default
# ANYTHING_LLM_BASE_URL=http://127.0.0.1:3001

# ========== 微信推送（可选，竞赛展演可不填）==========
# 企业微信
# WORK_WECHAT_CORPID=
# WORK_WECHAT_CORPSECRET=
# WORK_WECHAT_AGENTID=
# WORK_WECHAT_TIMEOUT_SECONDS=15

# 微信服务号
# WECHAT_SERVICE_APPID=
# WECHAT_SERVICE_SECRET=
# WECHAT_TEMPLATE_ID=
# WECHAT_TEMPLATE_DATA_KEYS=thing1,time2
# WECHAT_CALLBACK_TOKEN=
# WORK_WECHAT_CALLBACK_TOKEN=
# WORK_WECHAT_ENCODING_AES_KEY=

# ========== Hermes 本机微信告警 / 远程确认操作（可选）==========
# Hermes API Server: 在 ~/.hermes/.env 中设置 API_SERVER_ENABLED=true 和同一个 API_SERVER_KEY
# HERMES_API_SERVER_URL=http://127.0.0.1:8642/v1
# HERMES_API_SERVER_KEY=
# HERMES_WEIXIN_TARGET=weixin
# 链易配内部 API 供 Hermes 工具调用；请使用随机强 token，不要提交到仓库
# HERMES_LIANYIPEI_BASE_URL=http://127.0.0.1:5050
# HERMES_LIANYIPEI_TOKEN=
# HERMES_ACTION_CONFIRM_TTL_SECONDS=300
# HERMES_ALLOWED_REMOTE_ADDRS=127.0.0.1,::1,localhost
# HERMES_TRUST_PROXY_HEADERS=0

# ========== 高德地图（可选）==========
# AMAP_JS_KEY=
# AMAP_SECURITY_JS_CODE=
# AMAP_SERVICE_KEY=
