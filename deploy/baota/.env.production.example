# 复制到项目根目录 .env 后填写。不要把真实密钥提交到 Git。
# 宝塔部署推荐：/www/wwwroot/lianyipei/.env

APP_ENV=production
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=请使用-python-secrets-token_urlsafe-生成至少32字节随机值

# MySQL 8；密码中的 @ : / # ? 等字符必须 URL 编码。
DATABASE_URL=mysql+pymysql://lianyipei_app:URL编码后的密码@127.0.0.1:3306/lianyipei?charset=utf8mb4

# Neo4j 5.x，仅本机访问，不开放 7687 到公网。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请填写强密码

# 当前不是核心依赖；代码有兼容配置，比赛版可以不启动 Redis。
REDIS_URL=redis://127.0.0.1:6379/0

# 生产必须验证登录；Web 和 scheduler 都使用该根 .env。
DISABLE_API_AUTH=0
SCHEDULER_ENABLED=0
SCHEDULER_LOCK_FILE=/var/run/lianyipei/scheduler.lock

# 文件上传（代码默认位于项目 uploads 目录）；Nginx 同步限制 16 MB。
MAX_CONTENT_LENGTH=16777216

# Agent / BizMind：本机 Ollama 方案。
# 8 GB 服务器不要在本机运行大模型，改成独立模型服务器的内网地址。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
BIZMIND_OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# 没有真实接口时保持 false，系统继续使用模拟/本地数据完成演示。
POWER_API_ENABLED=false
TAX_API_ENABLED=false
INDUSTRIAL_COMMERCE_ENABLED=false

# 可选高德地图；不填不影响采购、询价、订单主链路。
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_SERVICE_KEY=

# 可选：协作 API。仅在确有外部系统调用时填写随机密钥。
COLLAB_API_KEYS=

# 可选：企业微信/公众号/Hermes。比赛主链路不依赖它们。
WORK_WECHAT_CORPID=
WORK_WECHAT_CORPSECRET=
WORK_WECHAT_AGENTID=
WECHAT_SERVICE_APPID=
WECHAT_SERVICE_SECRET=
WECHAT_TEMPLATE_ID=
WECHAT_CALLBACK_TOKEN=
HERMES_API_SERVER_URL=http://127.0.0.1:8642/v1
HERMES_API_SERVER_KEY=
HERMES_LIANYIPEI_BASE_URL=http://127.0.0.1:8000
HERMES_LIANYIPEI_TOKEN=
