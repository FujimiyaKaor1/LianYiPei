# 复制到项目根目录 .env 后填写。不要把真实密钥提交到 Git。
# 宝塔部署推荐：/www/wwwroot/lianyipei/.env

APP_ENV=production
FLASK_ENV=production
FLASK_DEBUG=0
PUBLIC_DATA_MODE=production
SECRET_KEY=请使用-python-secrets-token_urlsafe-生成至少32字节随机值
# 浏览器前端的完整 origin；多个来源用英文逗号分隔。生产不要填写 localhost。
TRUSTED_ORIGINS=https://your-domain.example

# MySQL 8；密码中的 @ : / # ? 等字符必须 URL 编码。
DATABASE_URL=mysql+pymysql://lianyipei_app:URL编码后的密码@127.0.0.1:3306/lianyipei?charset=utf8mb4

# Neo4j 5.x，仅本机访问，不开放 7687 到公网。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=请填写强密码

# 生产 smoke 将 Redis 作为必需依赖；仅本地开发可以省略。
REDIS_URL=redis://127.0.0.1:6379/0

# 生产必须验证登录；Web 和 scheduler 都使用该根 .env。
DISABLE_API_AUTH=0
SCHEDULER_ENABLED=0
SCHEDULER_LOCK_FILE=/var/run/lianyipei/scheduler.lock
# Supervisor 同机部署可依赖调度器锁；Web/Worker 分容器时使用 Redis 心跳。
WORKER_HEARTBEAT_KEY=lianyipei:worker:heartbeat
WORKER_HEARTBEAT_TTL_SECONDS=30
# 独立调度/Worker 进程设置为 1；Web 进程可保持 0
# LIANYIPEI_WORKER_ENABLED=1
CHAIN_XIAOYI_QUEUE_LEASE_SECONDS=900
# 供应商报价默认有效窗口（小时），每条询价可在预览时覆盖
CHAIN_XIAOYI_RFQ_DEADLINE_HOURS=72
CHAIN_XIAOYI_AUTO_RFQ_SUPPLIER_LIMIT=5
CHAINXIAOYI_DATA_MAX_AGE_DAYS=180

# 文件上传（代码默认位于项目 uploads 目录）；Nginx 同步限制 16 MB。
MAX_CONTENT_LENGTH=16777216

# 采购材料必须先病毒扫描，再加密写入私有对象存储；生产不可使用 basic/none。
MATERIAL_AV_MODE=clamav
CLAMAV_COMMAND=clamscan
MATERIAL_STORAGE_BACKEND=s3
MATERIAL_ENCRYPTION_KEY=请从密钥管理系统注入Fernet密钥
MATERIAL_S3_BUCKET=lianyipei-private-materials
MATERIAL_S3_REGION=cn-south-1
MATERIAL_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=请从密钥管理系统注入
AWS_SECRET_ACCESS_KEY=请从密钥管理系统注入

# Agent / BizMind：本机 Ollama 方案。
# 8 GB 服务器不要在本机运行大模型，改成独立模型服务器的内网地址。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
BIZMIND_OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# 推荐的链小易云端模型；真实密钥只注入部署环境，不要提交到仓库或写入日志。
DEEPSEEK_API_KEY=请从密钥管理系统注入
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAINXIAOYI_CLOUD_ENABLED=true
CHAINXIAOYI_CLOUD_REQUIRED=true
CHAINXIAOYI_CLOUD_FILE_CONSENT_REQUIRED=true
CHAINXIAOYI_REQUIRE_EXPLICIT_APPROVAL=true

# 外部事实接口没有凭据时会失败关闭，不会返回模拟企业/税务/电力事实。
POWER_API_ENABLED=false
TAX_API_ENABLED=false
INDUSTRIAL_COMMERCE_ENABLED=false

# 可选高德地图；不填不影响采购、询价、订单主链路。
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_SERVICE_KEY=

# 可选：协作 API。仅在确有外部系统调用时填写随机密钥。
COLLAB_API_KEYS=

# RFQ 外部渠道状态回调（HMAC-SHA256；请从密钥管理系统注入）
RFQ_DELIVERY_CALLBACK_SECRET=请从密钥管理系统注入
RFQ_QUOTE_CALLBACK_SECRET=请从密钥管理系统注入（不要复用外发回调密钥）
RFQ_EMAIL_INBOUND_SECRET=请从密钥管理系统注入（不要复用其他回调密钥）
FULFILLMENT_CALLBACK_SECRET=请从密钥管理系统注入（不要复用询价回调密钥）

# 可选：供应商邮件自动回收 Worker（IMAP over SSL）
INBOUND_EMAIL_ENABLED=false
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USERNAME=
INBOUND_IMAP_PASSWORD=请从密钥管理系统注入
INBOUND_IMAP_FOLDER=INBOX
INBOUND_EMAIL_CALLBACK_URL=https://your-domain.example/api/chain-xiaoyi/email-quote-inbound
INBOUND_EMAIL_BATCH_SIZE=20
INBOUND_EMAIL_TIMEOUT_SECONDS=20

# 可选：企业微信/公众号/Hermes。比赛主链路不依赖它们。
WORK_WECHAT_CORPID=
WORK_WECHAT_CORPSECRET=
WORK_WECHAT_AGENTID=
WECHAT_SERVICE_APPID=
WECHAT_SERVICE_SECRET=
WECHAT_TEMPLATE_ID=
WECHAT_CALLBACK_TOKEN=
HERMES_API_SERVER_URL=http://127.0.0.1:8642/v1
HERMES_API_SERVER_KEY=
HERMES_LIANYIPEI_BASE_URL=http://127.0.0.1:8000
HERMES_LIANYIPEI_TOKEN=
